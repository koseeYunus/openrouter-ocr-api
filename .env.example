# ============================================================================
# FastAPI Handwriting OCR Service - Environment Configuration
# ============================================================================
# 
# This file documents all environment variables used by the application.
# Copy this file to .env and fill in your actual values.
#
# Required variables are marked with [REQUIRED]
# Optional variables have default values shown in comments
#
# ============================================================================

# ============================================================================
# OpenRouter API Configuration
# ============================================================================

# [REQUIRED] OpenRouter API Key
# Get your API key from: https://openrouter.ai/keys
# This is the only required configuration variable
OPENROUTER_API_KEY=your-api-key-here

# OpenRouter API Base URL
# Default: https://openrouter.ai/api/v1
# Only change if using a different endpoint or proxy
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OCR Model Identifier (Deprecated - use OCR_MODEL_FALLBACK_LIST)
# Default: qwen/qwen2.5-vl-72b-instruct:free
# Available models: https://openrouter.ai/models
# OCR_MODEL_ID=qwen/qwen2.5-vl-72b-instruct:free

# OCR Model Fallback List
# Default: ["google/gemini-2.0-flash-exp:free", "qwen/qwen2.5-vl-72b-instruct:free", "meta-llama/llama-3.2-11b-vision-instruct:free"]
# Comma-separated prioritized list of models for fallback mechanism
# The service will try each model in order until one succeeds
# OCR_MODEL_FALLBACK_LIST=google/gemini-2.0-flash-exp:free,qwen/qwen2.5-vl-72b-instruct:free,meta-llama/llama-3.2-11b-vision-instruct:free

# ============================================================================
# Application Configuration
# ============================================================================

# Application Name
# Default: Handwriting OCR Service
# Displayed in API documentation and responses
# APP_NAME=Handwriting OCR Service

# Application Version
# Default: 2.0.0
# Displayed in API documentation
# APP_VERSION=2.0.0

# Environment
# Default: development
# Options: development, staging, production
# Affects logging verbosity and error detail exposure
# ENVIRONMENT=development

# ============================================================================
# Rate Limiting Configuration
# ============================================================================

# Rate Limit Per Minute
# Default: 10
# Maximum number of requests per IP address per minute
# Range: 1-1000
# RATE_LIMIT_PER_MINUTE=10

# Rate Limit Window
# Default: 60
# Time window for rate limiting in seconds
# RATE_LIMIT_WINDOW=60

# ============================================================================
# File Upload Configuration
# ============================================================================

# Maximum File Size (MB)
# Default: 10
# Maximum allowed file size for image uploads in megabytes
# Range: 1-100
# MAX_FILE_SIZE_MB=10

# Allowed Image Types
# Default: ["image/jpeg", "image/png", "image/webp"]
# Comma-separated list of allowed MIME types
# Note: This is handled in code, not typically set via env var
# ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ============================================================================
# Timeout Configuration
# ============================================================================

# OCR Processing Timeout
# Default: 30
# Maximum time in seconds to wait for OCR processing
# Range: 5-300
# OCR_TIMEOUT_SECONDS=30

# External API Timeout
# Default: 30
# Maximum time in seconds to wait for external API calls
# Range: 5-300
# EXTERNAL_API_TIMEOUT=30

# ============================================================================
# CORS Configuration
# ============================================================================

# CORS Allowed Origins
# Default: ["*"]
# Comma-separated list of allowed origins for CORS
# Use "*" for all origins (development only)
# For production, specify exact origins:
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# CORS_ORIGINS=*

# ============================================================================
# Logging Configuration
# ============================================================================

# Log Level
# Default: INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: Detailed information for debugging
# INFO: General informational messages
# WARNING: Warning messages for potential issues
# ERROR: Error messages for failures
# CRITICAL: Critical errors that may cause shutdown
# LOG_LEVEL=INFO

# Log File Path
# Default: logs/app.log
# Path to log file (relative or absolute)
# Set to empty string or omit for console-only logging
# Logs are automatically rotated (10MB max, 5 backups)
# LOG_FILE=logs/app.log

# ============================================================================
# Production Deployment Notes
# ============================================================================
#
# For production deployments:
# 1. Set ENVIRONMENT=production
# 2. Use a strong, unique OPENROUTER_API_KEY
# 3. Configure specific CORS_ORIGINS (not "*")
# 4. Adjust RATE_LIMIT_PER_MINUTE based on your needs
# 5. Set LOG_LEVEL=WARNING or ERROR to reduce log volume
# 6. Consider using a centralized logging solution
# 7. Monitor OCR_TIMEOUT_SECONDS and adjust based on performance
# 8. Regularly rotate API keys for security
#
# ============================================================================

# ============================================================================
# Docker Deployment
# ============================================================================
#
# When using Docker, you can:
# 1. Copy this file to .env and docker-compose will load it automatically
# 2. Pass environment variables directly in docker-compose.yml
# 3. Use Docker secrets for sensitive values in production
#
# Example docker-compose.yml environment section:
#   environment:
#     - OPENROUTER_API_KEY=${OPENROUTER_API_KEY}
#     - ENVIRONMENT=production
#     - LOG_LEVEL=WARNING
#
# ============================================================================

# ============================================================================
# Troubleshooting
# ============================================================================
#
# If you encounter issues:
#
# 1. Missing API Key Error:
#    - Ensure OPENROUTER_API_KEY is set in .env file
#    - Verify the .env file is in the project root directory
#
# 2. Rate Limit Errors:
#    - Increase RATE_LIMIT_PER_MINUTE if needed
#    - Check if multiple clients share the same IP
#
# 3. Timeout Errors:
#    - Increase OCR_TIMEOUT_SECONDS for large images
#    - Check network connectivity to OpenRouter API
#
# 4. File Upload Errors:
#    - Verify file size is under MAX_FILE_SIZE_MB
#    - Ensure file type is JPEG, PNG, or WebP
#
# 5. CORS Errors:
#    - Add your frontend domain to CORS_ORIGINS
#    - Use "*" for development only
#
# For more help, see: README.md or open an issue on GitHub
#
# ============================================================================
